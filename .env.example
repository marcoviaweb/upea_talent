# Copiar a .env para el desarrollo local. Valores solo para información ficticia.
DJANGO_SECRET_KEY=dev-only-replace-before-any-shared-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En despliegues HTTPS, con DJANGO_DEBUG=0, el redirect, HSTS y cookies seguras se activan por defecto.
# Ajusta HSTS solo si el dominio y todos sus subdominios operan exclusivamente con HTTPS.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_SECURE_HSTS_PRELOAD=0

POSTGRES_DB=upea_talent
POSTGRES_USER=upea_talent
POSTGRES_PASSWORD=local-dev-change-this
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
